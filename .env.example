# Aplicação
APP_NAME=AI Barbershop Assistant
APP_VERSION=0.1.0
DEBUG=false

# CORS — lista JSON de origens permitidas
CORS_ORIGINS=["http://localhost:3000"]

# Rate limiting
RATE_LIMIT=10/minute

# Banco de dados
# SQLite (dev simples, sem Docker):
DATABASE_URL=sqlite+aiosqlite:///./barbershop.db
# PostgreSQL local via docker compose:
# DATABASE_URL=postgresql+asyncpg://barbershop:barbershop@localhost:5432/barbershop
# Supabase (produção):
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# IA
GROQ_API_KEY=

# Segurança — obrigatórios em produção (DEBUG=false)
API_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
